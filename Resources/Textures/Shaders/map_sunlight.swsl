light_mode unshaded;

uniform highp vec2 CurrentOffset;
uniform highp vec2 PreviousOffset;
uniform sampler2D PreviousMask;
uniform bool BlendPrevious;

highp vec4 sampleMask(sampler2D mask, highp vec2 pixel)
{
    // Sunlight Changes: Resolve a stable edge footprint without alternating the raster position across frames.
    highp vec2 uv = pixel * TEXTURE_PIXEL_SIZE;
    highp vec2 filterOffset = 0.5 * TEXTURE_PIXEL_SIZE;
    return 0.5 * (zTextureSpec(mask, uv - filterOffset) + zTextureSpec(mask, uv + filterOffset));
}

void fragment()
{
    highp vec4 current = sampleMask(TEXTURE, FRAGCOORD.xy + CurrentOffset);
    highp float exposure = current.r;
    if (BlendPrevious && current.a > 0.0)
    {
        highp vec4 previous = sampleMask(PreviousMask, FRAGCOORD.xy + PreviousOffset);
        // Sunlight Changes: Fade only where both snapshots knew the geometry so receiver boundaries do not flash.
        exposure += 0.5 * min(current.a, previous.a) * (previous.r - current.r);
    }

    COLOR = vec4(1.0, 1.0, 1.0, exposure);
}
